# production 환경의 GitHub Secret `SERVER_ENV` 에 이 파일 내용을 통째로 넣는다.
# 배포 때마다 서버의 배포 디렉터리에 app.env 로 그대로 떨어진다.
#
# 파일명이 .env 가 아닌 이유: 배포 액션이 전송 묶음 최상위의 dotfile 을 빠뜨린다.

# The MySQL container is reachable as `mysql` on the external `readygsm-net` Docker network.
DATABASE_URL=mysql://root:CHANGE_ME@mysql:3306/lifeledger

# OAuth 콜백이 돌아올 출처 (§4.5). 제공자 콘솔에 등록한 redirect URI 와 앞부분이 같아야 한다.
# 서버는 여기에 /api/auth/{provider}/callback 을 붙여 쓴다.
PUBLIC_ORIGIN=https://lifeledger-ruby.vercel.app

# 로그인 제공자. 한 제공자의 ID·SECRET 은 **둘 다** 있거나 **둘 다** 없어야 한다.
# 둘 다 없으면 그 제공자는 로그인 화면에 나오지 않는다.
DATAGSM_CLIENT_ID=CHANGE_ME
DATAGSM_CLIENT_SECRET=CHANGE_ME
# scope 는 `{applicationId}:{scopeName}` 형식이다. 공개 문서의 `self:read` 는 invalid_scope 로
# 거부된다. 비워 두면 클라이언트에 등록된 scope 전체를 받으므로, 필요한 것만 적는다.
DATAGSM_SCOPE=datagsm:self_read
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

RUST_LOG=lifeledger_server=info,tower_http=warn,axum=warn

# Optional: how often the offline worker polls for eligible runs (250-60000 ms).
OFFLINE_WORKER_POLL_MILLIS=5000
