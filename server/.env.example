# Server bind address (default 127.0.1:8080)
BIND_ADDR=127.0.0.1:8080
# Game state is stored here. The server will not start if this is not set.
DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/lifeledger
# OAuth callback origin (default http://localhost:8080)
PUBLIC_ORIGIN=http://localhost:8080
# Sign-in providers. Only filled providers will appear on the login screen.
DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
# `{applicationId}:{scopeName}` format. If left empty, all scopes registered in the client will be received.
DATAGSM_SCOPE=datagsm:self_read
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Market-data batch. The API server starts without these values.
# See plan-docs/market-data-keys.md for service approvals and usage boundaries.
DATA_GO_KR_SERVICE_KEY=
KRX_AUTH_KEY=
OPENDART_API_KEY=
FMP_API_KEY=
ECOS_API_KEY=
ECOS_STATISTIC_CODE=
ECOS_PERIOD_CODE=
ECOS_ITEM_CODES=
KOSIS_API_KEY=
KOSIS_ORG_ID=
KOSIS_TABLE_ID=
# tracing filter (default lifeledger_server=debug,tower_http=debug,axum=info)
RUST_LOG=lifeledger_server=debug,tower_http=debug,axum=info
