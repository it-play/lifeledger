# 서버가 바인드할 주소 (기본값 127.0.0.1:8080)
BIND_ADDR=127.0.0.1:8080

# 게임 상태를 두는 곳. 없으면 서버가 기동하지 않는다.
DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/lifeledger

# OAuth 콜백이 돌아올 출처 (기본값 http://localhost:8080)
PUBLIC_ORIGIN=http://localhost:8080

# 로그인 제공자 (§4.5). 채운 제공자만 로그인 화면에 나온다.
DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# tracing 필터 (기본값 lifeledger_server=debug,tower_http=debug,axum=info)
RUST_LOG=lifeledger_server=debug,tower_http=debug,axum=info
